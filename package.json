{
  "name": "shenlong-etf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "test:regression": "node --import tsx scripts/regression-check.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^5.27.0",
    "cheerio": "^1.1.0",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "description": "神龙ETF：中国宽基ETF公开行情、成交对比、日度份额与技术提醒看板",
  "repository": {
    "type": "git",
    "url": "https://github.com/loong0306/shenlong-etf.git"
  }
}
